import random

print("HANDOFF SIMULATION WITH HYSTERESIS")
print("----------------------------------------")

hysteresis = 5
serving_cell = "Cell A"
target_cell = "Cell B"

handoff_count = 0

print("Initial Serving Cell:", serving_cell)

for time in range(1, 16):

    serving_signal = random.randint(30, 80)
    target_signal = random.randint(30, 80)

    print("\nTime Step:", time)
    print("Serving Cell Signal:", serving_signal, "dBm")
    print("Target Cell Signal:", target_signal, "dBm")

    # Handoff decision using hysteresis
    if target_signal > serving_signal + hysteresis:

        print("Handoff Condition Satisfied")

        serving_cell, target_cell = target_cell, serving_cell

        handoff_count += 1

        print("Handoff Successful!")
        print("New Serving Cell:", serving_cell)

    else:
        print("No Handoff Required")
        print("Connected to:", serving_cell)

print("\nFINAL RESULTS")
print("----------------------------------------")
print("Total Handoffs:", handoff_count)
print("Final Serving Cell:", serving_cell)

if handoff_count > 0:
    print("Handoff Status: Handoffs Occurred")
else:
    print("Handoff Status: No Handoffs Occurred")
